<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.tiffany.topic-monitor</string>

    <key>ProgramArguments</key>
    <array>
        <!-- Replace with your Python path: run `which python3` to find it -->
        <string>/Library/Frameworks/Python.framework/Versions/3.14/bin/python3</string>
        <!-- Replace YOUR_USERNAME with your macOS username -->
        <string>/Users/YOUR_USERNAME/.claude/skills/topic-monitor/scripts/run_daily.py</string>
    </array>

    <key>WorkingDirectory</key>
    <!-- Replace YOUR_USERNAME with your macOS username -->
    <string>/Users/YOUR_USERNAME/.claude/skills/topic-monitor</string>

    <!-- Fire once daily at the fixed configured digest time. -->
    <key>StartCalendarInterval</key>
    <dict><key>Hour</key><integer>8</integer><key>Minute</key><integer>0</integer></dict>

    <key>StandardOutPath</key>
    <!-- Replace YOUR_USERNAME with your macOS username -->
    <string>/Users/YOUR_USERNAME/.claude/skills/topic-monitor/logs/daily.log</string>

    <key>StandardErrorPath</key>
    <!-- Replace YOUR_USERNAME with your macOS username -->
    <string>/Users/YOUR_USERNAME/.claude/skills/topic-monitor/logs/daily.error.log</string>

    <!-- Throttle: don't re-run if it crashed within 60 seconds -->
    <key>ThrottleInterval</key>
    <integer>60</integer>
</dict>
</plist>
